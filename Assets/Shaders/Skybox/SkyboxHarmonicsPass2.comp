layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140) readonly buffer InputBuffer {
	vec3 BlockHarmonics[];
};

layout(std140) buffer OutputBuffer {
	vec3 Harmonics[9];
};

uniform uint BlockCount;

shared vec3 LocalHarmonics[64][9];

void lovrmain() {
	for (uint i = 0; i < 9; ++i) {
		LocalHarmonics[gl_LocalInvocationIndex][i] = vec3(0.0);
	}

	barrier();

	for (uint i = gl_LocalInvocationIndex; i < BlockCount; i += gl_WorkGroupSize.x) {
		uint offset = i * 9;

		for (uint j = 0; j < 9; ++j) {
			LocalHarmonics[gl_LocalInvocationIndex][j] += BlockHarmonics[offset + j];
		}
	}

	barrier();

	if (gl_LocalInvocationIndex < 9) {
		for (uint i = 0; i < gl_WorkGroupSize.x; ++i) {
			Harmonics[gl_LocalInvocationIndex] += LocalHarmonics[i][gl_LocalInvocationIndex];
		}
	}
}